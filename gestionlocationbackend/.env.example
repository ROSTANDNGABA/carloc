# PostgreSQL
DB_NAME=carloc_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432

# Django
SECRET_KEY=changez-moi-en-production

# Production
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Securite HTTPS - activez uniquement lorsque le site est servi en HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Développement local uniquement :
# DEBUG=True
# Si DEBUG=False mais vous utilisez /admin/ en local, activez aussi :
# CARLOC_SERVE_STATIC=1
# 
# Compte admin systeme CarLoc : cree/mis a jour apres migrations et par ensure_admin.
CARLOC_ADMIN_USERNAME=admin@carloc.cm
CARLOC_ADMIN_EMAIL=admin@carloc.cm
CARLOC_ADMIN_PASSWORD=changez-moi-avant-hebergement
#
# Interface /admin/ : thème django-jazzmin (voir JAZZMIN_SETTINGS dans settings.py).
# Après installation : pip install -r requirements.txt puis redémarrer runserver.
# Mot de passe admin court (ex. « 123 ») : avec DEBUG=True, les validateurs Django
# sont désactivés et ensure_admin accepte ≥3 caractères. Sinon, sans DEBUG :
# CARLOC_ALLOW_SHORT_ADMIN_PASSWORD=1
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# CSRF_TRUSTED_ORIGINS=
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Monitoring (Sentry + Prometheus) ---
# Sentry : créez un projet sur https://sentry.io et copiez le DSN
# SENTRY_DSN=https://xxxx@o000000.ingest.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=carloc@1.0.0

# Prometheus : métriques sur GET /metrics (activé par défaut si DEBUG=True)
# PROMETHEUS_ENABLED=1
# PROMETHEUS_METRICS_TOKEN=changez-moi-en-production

# Celery (optionnel)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=0

# --- Cache Redis (dashboard + sessions optionnelles) ---
# REDIS_URL=redis://localhost:6379/1
# DASHBOARD_CACHE_ENABLED=1
# DASHBOARD_CACHE_TTL=300

# --- Documents clients (chiffrement + S3 optionnel) ---
# Clé Fernet (générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CARLOC_FILE_ENCRYPTION_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Images publiques persistantes (Cloudinary) ---
# Copiez la variable CLOUDINARY_URL depuis le Dashboard Cloudinary.
# Exemple de format : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=

# --- E-mail CarLoc ---
# Fournisseur : smtp ou emailjs.
EMAIL_PROVIDER=smtp

# Mode production avec EmailJS :
# EMAIL_PROVIDER=emailjs
# EMAILJS_SERVICE_ID=service_xxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxx
# EMAILJS_PUBLIC_KEY=xxxxxxxx
# EMAILJS_PRIVATE_KEY=xxxxxxxx
# Mode test (affiche les mails dans le terminal, sans envoi réel) :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Mode production (SMTP) :
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail (recommandé si vous utilisez @gmail.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=votre.adresse@gmail.com
EMAIL_HOST_PASSWORD=mot_de_passe_application_16_caracteres

# L'expéditeur doit correspondre au compte Gmail (ou alias validé)
DEFAULT_FROM_EMAIL=votre.adresse@gmail.com
CARLOC_ADMIN_EMAIL=votre.adresse@gmail.com

# Alternative port 465 (SSL) :
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
